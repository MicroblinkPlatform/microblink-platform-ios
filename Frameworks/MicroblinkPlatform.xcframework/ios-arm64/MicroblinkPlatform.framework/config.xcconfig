// Version settings
SDK_VERSION = 1.7.0
MARKETING_VERSION = 1.7.0
CURRENT_PROJECT_VERSION = 1.7.0

// Strip settings
STRIPFLAGS = "-rSTx"
DEPLOYMENT_POSTPROCESSING = YES
STRIP_STYLE = non-global
STRIP_SWIFT_SYMBOLS = YES
